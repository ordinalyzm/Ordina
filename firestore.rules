rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isGlobalAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/groups/global_channel).data.ownerId == request.auth.uid;
    }

    // User profiles
    match /users/{userId} {
      allow read, list: if isAuthenticated();
      allow write: if isOwner(userId) || isGlobalAdmin();
    }

    // Messages
    match /messages/{messageId} {
      allow read, list: if isAuthenticated() && (
        isGlobalAdmin() ||
        (resource.data.senderId == request.auth.uid) ||
        (resource.data.receiverId == request.auth.uid) ||
        (resource.data.groupId != null && 
         exists(/databases/$(database)/documents/groups/$(resource.data.groupId)) &&
         !(request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.get('bannedUsers', [])))
      );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isGlobalAdmin() ||
        (resource.data.senderId == request.auth.uid && (!('deleted' in request.resource.data) || request.resource.data.deleted == true)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gameState'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])) ||
        (resource.data.groupId != null && 
         get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberRoles[request.auth.uid] in ['owner', 'admin'])
      );
      allow delete: if isAuthenticated() && (
        isGlobalAdmin() ||
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid ||
        (resource.data.groupId != null && 
         get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberRoles[request.auth.uid] in ['owner', 'admin'])
      );
    }

    // Groups
    match /groups/{groupId} {
      allow read, list: if isAuthenticated() && (
        isGlobalAdmin() ||
        groupId == 'global_channel' ||
        resource.data.isPublic == true ||
        request.auth.uid in resource.data.members ||
        resource.data.ownerId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isGlobalAdmin() ||
        (resource.data.memberRoles[request.auth.uid] in ['owner', 'admin']) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])) ||
        (resource.data.ownerId == 'system')
      );
      allow delete: if isAuthenticated() && (isGlobalAdmin() || resource.data.ownerId == request.auth.uid);
    }

    // File Metadata
    match /fileMetadata/{fileId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uploaderId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uploaderId == request.auth.uid;
    }

    // File Chunks
    match /fileChunks/{chunkId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Sticker Packs
    match /stickerPacks/{packId} {
      allow read, list: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }
  }
}
