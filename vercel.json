{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ordina-server.onrender.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://ordina-server.onrender.com/socket.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
